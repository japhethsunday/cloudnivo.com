# ── CloudNivo production. Start from `.env.example`, then override: ──
# PRODUCTION RULES (see docs/deployment.md):
# - NEVER commit this file with real values. Production secrets live ONLY in
#   the Railway environment (and Vercel env for NEXT_PUBLIC_API_URL).
# - Rotate JWT_SECRET / STORAGE_SIGNING_SECRET / DB passwords if ever exposed.
# - Run `npm run db:migrate && npm run db:seed` on deploy (or MIGRATE_ON_BOOT).

NODE_ENV=production
# The console's canonical origin is the apex. Every generated link — email
# verification, password reset, billing — is built from APP_URL, so it decides
# which host users land on.
APP_URL=https://cloudnivo.org
API_URL=https://api.cloudnivo.org
PUBLIC_API_URL=https://api.cloudnivo.org
# List every origin a browser actually loads the console from. www stays here
# while the edge still redirects apex → www; drop it once that flips.
CORS_ORIGINS=https://cloudnivo.org,https://www.cloudnivo.org
NEXT_PUBLIC_API_URL=https://api.cloudnivo.org

DATABASE_URL=postgres://USER:PASSWORD@prod-pg.railway.internal:5432/cloudnivo
MANAGED_PG_URL=postgres://USER:PASSWORD@prod-pg.railway.internal:5432/cloudnivo
REDIS_URL=redis://:PASSWORD@prod-redis.railway.internal:6379
REDIS_PASSWORD=set-a-strong-password
# Refuse boot unless the shared cache answers (rate limits + session
# revocation must be shared across instances).
REQUIRE_REDIS=true

JWT_SECRET=generate-a-fresh-48-byte-secret-per-environment
JWT_ISSUER=cloudnivo

CONTROL_STORE=drizzle
MIGRATE_ON_BOOT=true
PROVISION_DRIVER=managed
PROVISION_MAX_DATABASES=100
REALTIME_DRIVER=redis
REALTIME_STANDALONE=true
FUNCTION_RUNTIME=worker
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=cloudnivo-prod
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_SIGNING_SECRET=generate-a-fresh-32-char-secret-per-environment
STORAGE_PROJECT_QUOTA_MB=10240

# Billing (Phase 12): manual by default; set BILLING_WEBHOOK_SECRET per env
# when a provider forwards events. Never commit the real secret.
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=
BILLING_RAW_RETENTION_DAYS=90

# Automated backups (worker service; BACKUP_DIR = attached Railway volume).
BACKUP_ENABLED=true
BACKUP_DIR=/var/lib/cloudnivo/backups
BACKUP_INTERVAL_MS=3600000
BACKUP_RETENTION_COUNT=7
BACKUP_ENCRYPTION_KEY=generate-a-fresh-32-char-secret-per-environment
# BACKUP_VERIFY_URL=postgres://USER:PASSWORD@prod-pg.railway.internal:5432/cn_verify

# Project vault (AES-256-GCM, 32+ chars). Required when the vault API is used.
VAULT_KEY=generate-a-fresh-32-char-secret-per-environment
# Customer email/SMS/captcha providers (memory/disabled defaults are dev-only).
# Production sends through Resend. RESEND_FROM's address must belong to a
# domain that is fully Verified in Resend — a Partially Verified domain is
# rejected at send time, and the API reports the send as not delivered rather
# than pretending otherwise.
EMAIL_DRIVER=resend

# ── Platform staff (operator console at /admin) ─────────────────────────
# Comma-separated emails promoted to platform staff on boot AND at signup, so
# it works whether the operator registered before or after this was set. It
# only ever GRANTS: removing an address here does not demote anyone, because
# demotion must be deliberate (clear users.is_platform_admin) rather than a
# side effect of editing an env var. Staff read across every tenant, so keep
# this list as short as the job allows.
PLATFORM_ADMIN_EMAILS=
RESEND_API_KEY=set-in-railway-never-in-git
RESEND_FROM=CloudNivo <noreply@noreply.cloudnivo.org>
SMS_DRIVER=memory
CAPTCHA_PROVIDER=disabled
