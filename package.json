{
  "name": "cloudnivo",
  "private": true,
  "version": "0.1.0",
  "description": "CloudNivo — developer-focused Backend-as-a-Service platform (control plane foundation, Phase 1)",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/dashboard",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:realtime": "npm run dev:realtime --workspace=apps/api",
    "build:packages": "npm run build --workspace=packages/config --workspace=packages/logging --workspace=packages/validation --workspace=packages/database --workspace=packages/auth --workspace=packages/storage --workspace=packages/realtime --workspace=packages/functions --workspace=packages/ai --workspace=packages/billing --workspace=packages/agents --workspace=packages/automation --workspace=packages/sdk --workspace=packages/cli --workspace=packages/cache --workspace=packages/provisioning --workspace=packages/api-core --workspace=packages/api-engine --if-present",
    "build": "npm run build:packages && npm run build --workspace=apps/api --workspace=apps/dashboard --if-present",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:smoke": "node tests/smoke-prod.mjs",
    "test:load": "tsx tests/load/run.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace=packages/database --if-present",
    "db:migrate": "npm run db:migrate --workspace=packages/database --if-present",
    "db:seed": "npm run db:seed --workspace=packages/database --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
