{
  "name": "cloudnivo",
  "private": true,
  "version": "0.1.0",
  "description": "CloudNivo — developer-focused Backend-as-a-Service platform (control plane foundation, Phase 1)",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/dashboard",
    "dev:api": "npm run dev --workspace=apps/api",
    "build:packages": "npm run build --workspace=packages/config --workspace=packages/logging --workspace=packages/validation --workspace=packages/database --workspace=packages/auth --workspace=packages/storage --workspace=packages/realtime --workspace=packages/cache --workspace=packages/provisioning --workspace=packages/api-core --workspace=packages/api-engine --if-present",
    "build": "npm run build:packages && npm run build --workspace=apps/api --workspace=apps/dashboard --if-present",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace=packages/database --if-present",
    "db:migrate": "npm run db:migrate --workspace=packages/database --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.8"
  }
}
