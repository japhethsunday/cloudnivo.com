{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "stripInternal": true,
    "baseUrl": ".",
    "paths": {
      "@cloudnivo/config": ["./packages/config/src/index.ts"],
      "@cloudnivo/config/*": ["./packages/config/src/*"],
      "@cloudnivo/logging": ["./packages/logging/src/index.ts"],
      "@cloudnivo/logging/*": ["./packages/logging/src/*"],
      "@cloudnivo/validation": ["./packages/validation/src/index.ts"],
      "@cloudnivo/validation/*": ["./packages/validation/src/*"],
      "@cloudnivo/database": ["./packages/database/src/index.ts"],
      "@cloudnivo/database/*": ["./packages/database/src/*"],
      "@cloudnivo/auth": ["./packages/auth/src/index.ts"],
      "@cloudnivo/auth/*": ["./packages/auth/src/*"],
      "@cloudnivo/storage": ["./packages/storage/src/index.ts"],
      "@cloudnivo/storage/*": ["./packages/storage/src/*"],
      "@cloudnivo/realtime": ["./packages/realtime/src/index.ts"],
      "@cloudnivo/realtime/*": ["./packages/realtime/src/*"],
      "@cloudnivo/cache": ["./packages/cache/src/index.ts"],
      "@cloudnivo/cache/*": ["./packages/cache/src/*"],
      "@cloudnivo/provisioning": ["./packages/provisioning/src/index.ts"],
      "@cloudnivo/provisioning/*": ["./packages/provisioning/src/*"],
      "@cloudnivo/api-core": ["./packages/api-core/src/index.ts"],
      "@cloudnivo/api-core/*": ["./packages/api-core/src/*"],
      "@cloudnivo/api-engine": ["./packages/api-engine/src/index.ts"],
      "@cloudnivo/api-engine/*": ["./packages/api-engine/src/*"],
      "@cloudnivo/functions": ["./packages/functions/src/index.ts"],
      "@cloudnivo/functions/*": ["./packages/functions/src/*"],
      "@cloudnivo/ai": ["./packages/ai/src/index.ts"],
      "@cloudnivo/ai/*": ["./packages/ai/src/*"],
      "@cloudnivo/billing": ["./packages/billing/src/index.ts"],
      "@cloudnivo/billing/*": ["./packages/billing/src/*"],
      "@cloudnivo/agents": ["./packages/agents/src/index.ts"],
      "@cloudnivo/agents/*": ["./packages/agents/src/*"],
      "@cloudnivo/automation": ["./packages/automation/src/index.ts"],
      "@cloudnivo/automation/*": ["./packages/automation/src/*"],
      "@cloudnivo/cli": ["./packages/cli/src/index.ts"],
      "@cloudnivo/cli/*": ["./packages/cli/src/*"],
      "@cloudnivo/sdk": ["./packages/sdk/src/index.ts"],
      "@cloudnivo/sdk/*": ["./packages/sdk/src/*"]
    }
  }
}
