# CloudNivo background worker image (Railway / Docker / VPS).
# Drains orphaned provisioning jobs from the shared job store. Requires
# CONTROL_STORE=drizzle to share state with the API; with memory stores it
# polls idle (see apps/api/src/worker.ts).
# Build from the repo root:  docker build -f Dockerfile.worker -t cloudnivo-worker .
# No secrets are baked in — every value arrives via environment at runtime.
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN npm ci --no-audit --no-fund && \
    npm run build:packages && \
    npm run build --workspace=@cloudnivo/api

FROM node:20-alpine AS runtime
ENV NODE_ENV=production
# pg_dump/pg_restore for scheduled control-plane backups (backup-scheduler).
RUN apk add --no-cache postgresql-client
WORKDIR /app
COPY package.json package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
RUN chown -R node:node /app
USER node
EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3003/api/v1/health/live || exit 1
CMD ["node", "apps/api/dist/worker.js"]
