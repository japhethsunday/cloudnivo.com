# ── CloudNivo local overrides. Start from `.env.example`, then apply: ──
# cp .env.example .env   (this file documents local-only tweaks)
#
# Local development runs everything on your machine:
#   docker compose up -d            # postgres + redis
#   npm run dev:api                 # API on :3001 (PROVISION_DRIVER=docker)
#   npm run dev                     # dashboard on :3000
#   npm run dev:worker              # optional: orphan-drain worker (:3003)

PROVISION_DRIVER=docker
PROVISION_HOST_MODE=loopback
CONTROL_STORE=memory
REALTIME_DRIVER=memory
FUNCTION_RUNTIME=worker
STORAGE_DRIVER=local
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
