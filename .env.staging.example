# ── CloudNivo staging. Start from `.env.example`, then override: ──
# Mirrors production architecture (managed PG, drizzle stores, worker,
# standalone realtime) against staging domains. NEVER commit real values —
# staging secrets live in the Railway staging environment, not in git.

NODE_ENV=production
APP_URL=https://dashboard-staging.example.com
API_URL=https://api-staging.example.com
PUBLIC_API_URL=https://api-staging.example.com
CORS_ORIGINS=https://dashboard-staging.example.com
NEXT_PUBLIC_API_URL=https://api-staging.example.com

# Staging Postgres plugin (Railway) — also the managed-provisioning host.
DATABASE_URL=postgres://USER:PASSWORD@staging-pg.railway.internal:5432/cloudnivo
MANAGED_PG_URL=postgres://USER:PASSWORD@staging-pg.railway.internal:5432/cloudnivo
REDIS_URL=redis://:PASSWORD@staging-redis.railway.internal:6379

JWT_SECRET=generate-a-fresh-48-byte-secret-per-environment
JWT_ISSUER=cloudnivo-staging

CONTROL_STORE=drizzle
MIGRATE_ON_BOOT=true
PROVISION_DRIVER=managed
REALTIME_DRIVER=redis
REALTIME_STANDALONE=true
FUNCTION_RUNTIME=worker
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=https://staging-s3.example.com
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=cloudnivo-staging
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_SIGNING_SECRET=generate-a-fresh-32-char-secret-per-environment

# Billing (Phase 12): manual by default; staging webhook secret lives in env.
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=
BILLING_RAW_RETENTION_DAYS=90
