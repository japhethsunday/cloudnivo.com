{
  "name": "@cloudnivo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:realtime": "tsx watch src/realtime-standalone.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@cloudnivo/ai": "0.1.0",
    "@cloudnivo/api-core": "0.1.0",
    "@cloudnivo/api-engine": "0.1.0",
    "@cloudnivo/auth": "0.1.0",
    "@cloudnivo/cache": "0.1.0",
    "@cloudnivo/config": "0.1.0",
    "@cloudnivo/database": "0.1.0",
    "@cloudnivo/functions": "0.1.0",
    "@cloudnivo/logging": "0.1.0",
    "@cloudnivo/provisioning": "0.1.0",
    "@cloudnivo/realtime": "0.1.0",
    "@cloudnivo/storage": "0.1.0",
    "@cloudnivo/validation": "0.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.1"
  }
}
