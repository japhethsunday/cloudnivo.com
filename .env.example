# ── CloudNivo local/dev example. Copy to `.env` and fill in real values. ──
# NEVER commit `.env` with real secrets.

# ── Runtime ──
NODE_ENV=development
LOG_LEVEL=info
# Public base URL of the dashboard. Every link the backend generates is built
# from this: verification and password-reset emails, the billing dashboard
# link, and the Secure flag on the session cookie (set when it is https).
# Production canonical origin is the apex: APP_URL=https://cloudnivo.org
APP_URL=http://localhost:3000
# Base URL of the standalone API (apps/api). Dashboard API routes use APP_URL.
API_URL=http://localhost:3001
API_PORT=3001

# ── Database (Docker compose defaults) ──
POSTGRES_USER=cloudnivo
POSTGRES_PASSWORD=cloudnivo_dev_password_change_me
POSTGRES_DB=cloudnivo
POSTGRES_PORT=5432
# Control-plane connection string. The app reads DATABASE_URL first.
DATABASE_URL=postgres://cloudnivo:cloudnivo_dev_password_change_me@localhost:5432/cloudnivo

# ── Redis (Docker compose defaults) ──
REDIS_PORT=6379
REDIS_PASSWORD=
# ioredis URL. Empty password in local dev is OK; production MUST set one.
REDIS_URL=redis://localhost:6379

# ── Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ISSUER=cloudnivo
JWT_EXPIRES_IN=3600

# ── CORS ──
# Comma-separated allowlist for browser clients. Keep tight in production.
# It must list every origin a browser actually loads the console from — the
# canonical apex, the www host while the edge still redirects to it, and any
# preview host that has to reach this API:
#   CORS_ORIGINS=https://cloudnivo.org,https://www.cloudnivo.org
CORS_ORIGINS=http://localhost:3000

# ── Rate limiting (in-memory default; Redis-backed in production) ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ── Edge defence: WAF + adaptive IP reputation (docs/ddos-response.md) ──
# The WAF filters malicious request SHAPES before routing — traversal, SQL
# injection syntax, XSS, command injection, scanner probes. It does NOT inspect
# bodies on tenant data planes, because that is where customers' own SQL and
# JSON legitimately live.
#   block  = refuse a match (default, and what production should run)
#   report = log and score the match, serve the request anyway. Use this for
#            the first days on a new deployment to prove the rules are clean
#            against real traffic before enforcing them.
#   off    = no inspection
WAF_MODE=block

# Adaptive rate limiting: per-IP score that escalates normal → throttled →
# banned on BEHAVIOUR. Failed logins against many accounts and 404s across many
# paths score far higher than the same account or path retried, so a busy
# customer is not treated like a scanner. Bans expire on their own and are
# shared across instances when REDIS_URL is set.
THREAT_THROTTLE_AT=50
THREAT_BAN_AT=120
# Score lifetime. The score decays by expiring, so a quiet IP recovers.
THREAT_WINDOW_S=900
THREAT_BAN_S=900
# Requests per minute a throttled IP still gets — degraded, not cut off.
THREAT_THROTTLED_BUDGET=10
# Never scored or banned: health checkers, office egress. Comma-separated.
THREAT_ALLOWLIST_IPS=

# Largest request body accepted, enforced WHILE STREAMING (never buffered past
# it). 1 MB default.
MAX_BODY_BYTES=1048576
# Fail production boot unless the shared cache (Redis) answers ping.
# Set true once a Redis service is attached to the production project.
REQUIRE_REDIS=false

# ── Storage (Phase 5: buckets + objects) ──
# local = real filesystem persistence ($0 dev); s3 = S3-compatible object store.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
# S3-compatible backend (production persistent storage):
# STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
# Storage limits + budgets (enforced server-side, never hard-coded in routes):
STORAGE_MAX_FILE_MB=50
STORAGE_MAX_BUCKETS=20
STORAGE_PROJECT_QUOTA_MB=1024
STORAGE_RATE_MAX=60
# Capability-token signing (HMAC); leave empty for an ephemeral dev secret.
STORAGE_SIGNING_SECRET=
STORAGE_MAX_SIGNED_TTL_S=3600

# ── Realtime (Phase 6: WebSocket gateway + PostgreSQL CDC + presence) ──
# memory = single-process dev/test; redis = multi-instance prod fan-out.
REALTIME_DRIVER=memory
# Standalone WS service (independent Railway service): REALTIME_STANDALONE=true
# serves upgrades on REALTIME_PORT with the same gateway/auth/bus code.
REALTIME_PORT=3002
REALTIME_STANDALONE=false
REALTIME_HEARTBEAT_MS=25000
REALTIME_HEARTBEAT_TIMEOUT_MS=60000
REALTIME_MAX_CONNS_PER_PROJECT=500
REALTIME_MAX_SUBS_PER_CONN=50
REALTIME_MAX_PAYLOAD_BYTES=65536
REALTIME_MAX_MSG_PER_SECOND=20
REALTIME_MAX_BROADCASTS_PER_MINUTE=60

# ── Control plane durability (Phase 8) ──
# memory = dev/test default; drizzle = Postgres-backed stores (run db:migrate + db:seed).
CONTROL_STORE=memory
# Opt-in boot migration for container deploys (default OFF; prefer explicit
# db:migrate in CI/release). Failures halt boot instead of serving stale schema.
MIGRATE_ON_BOOT=false

# ── Background worker (Phase 11) ──
# Drains orphaned provisioning jobs from the shared store. Needs
# CONTROL_STORE=drizzle to share state with the API.
WORKER_PORT=3003
WORKER_POLL_MS=15000
WORKER_STALE_MS=300000
WORKER_DRAIN_MS=30000

# ── Functions (Phase 7: serverless; worker isolates by default) ──
# worker = per-invocation isolates (no engine needed); docker = per-version
# container images run with --network none + caps (needs a Docker engine).
FUNCTION_RUNTIME=worker
FUNCTION_EXECUTION_TIMEOUT_MS=10000
FUNCTION_MEMORY_MB=128
FUNCTION_MAX_BODY_BYTES=262144
FUNCTION_MAX_RESPONSE_BYTES=1048576
FUNCTION_MAX_CONCURRENCY=10
FUNCTION_MAX_DEPLOY_BYTES=5242880
FUNCTION_MAX_FUNCTIONS_PER_PROJECT=50
FUNCTION_MAX_ENV_VALUE_BYTES=8192
FUNCTION_MAX_LOG_ENTRIES=500
FUNCTION_LOG_RETENTION_DAYS=7
FUNCTION_INVOKE_RATE_MAX=60
# Public base URL served to developers (leave empty for same-origin API):
# FUNCTION_BASE_URL=https://functions.example.com

# ── Provisioning (Phase 2: local Docker database engine) ──
# docker = real containers; fake = test-only in-memory provider (never in prod).
PROVISION_DRIVER=docker
# managed = per-project database+role in one shared Postgres (Railway/RDS).
# Requires MANAGED_PG_URL (privileged). On Railway: the Postgres plugin URL.
MANAGED_PG_URL=
POSTGRES_IMAGE=postgres:16-alpine
PROVISION_NETWORK=cloudnivo
# loopback = DBs via 127.0.0.1:mapped-port (host-run API);
# container = DBs via container-name:5432 (containerized API on same network).
PROVISION_HOST_MODE=loopback
PROVISION_BASE_PORT=15432
# Resource limits (enforced server-side, never hard-coded in routes):
PROVISION_MAX_DATABASES=20
PROVISION_MAX_DB_SIZE_MB=1024
PROVISION_MAX_CONNECTIONS=50
PROVISION_MAX_SQL_MS=15000
PROVISION_MAX_SQL_ROWS=500
PROVISION_MAX_ATTEMPTS=3
PROVISION_HEALTH_TIMEOUT_MS=60000
# Dashboard → standalone API base URL (used by client components):
# NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Data API engine (Phase 3: generated per-table REST) ──
# Stable per-project base URL (local vs Railway/Vercel/custom):
PUBLIC_API_URL=http://localhost:3001
# Per-key and per-project rate budgets (per RATE_LIMIT_WINDOW_MS):
DATA_API_KEY_MAX=300
DATA_API_PROJECT_MAX=1000
# Introspection cache TTL (live re-read on expiry; writes invalidate):
INTROSPECTION_TTL_MS=30000

# ── Customer auth (Phase 4: per-project application users) ──
AUTH_ACCESS_TTL_S=900
AUTH_REFRESH_TTL_S=2592000
AUTH_RESET_TTL_S=3600
AUTH_VERIFY_TTL_S=86400
# Strict per-endpoint budget for signup/login/reset/verify/refresh:
AUTH_RATE_MAX=10
# memory = local/dev outbox (honestly queued, never delivered)
EMAIL_DRIVER=memory

# ── Platform staff (operator console at /admin) ─────────────────────────
# Comma-separated emails promoted to platform staff on boot AND at signup, so
# it works whether the operator registered before or after this was set. It
# only ever GRANTS: removing an address here does not demote anyone, because
# demotion must be deliberate (clear users.is_platform_admin) rather than a
# side effect of editing an env var. Staff read across every tenant, so keep
# this list as short as the job allows.
PLATFORM_ADMIN_EMAILS=
# Transactional email (Resend API or SMTP submission). Leave empty for the
# memory outbox in dev; production sets one driver + sender.
# EMAIL_DRIVER=resend
RESEND_API_KEY=
RESEND_FROM=
# EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=starttls
# Phone OTP via generic HTTP gateway; memory = dev outbox (never delivered).
SMS_DRIVER=memory
# SMS_DRIVER=http
SMS_HTTP_ENDPOINT=
SMS_HTTP_API_KEY=
# Bot protection for signup/login. disabled = open; turnstile/hcaptcha
# enforce verification when keyed (secret server-side only).
CAPTCHA_PROVIDER=disabled
CAPTCHA_SECRET_KEY=
# Customer password policy (min length 8-64, min character classes 0-4).
# 8/0 preserves the legacy default; production should raise both.
# Reverse proxies in front of the API (Railway/Vercel: 1). Only this many
# right-hand X-Forwarded-For entries are trusted when deriving the client IP
# for rate limiting; 0 ignores the header entirely. A wrong value here either
# rate-limits every caller as one, or lets a spoofed header split the buckets.
TRUSTED_PROXY_HOPS=1

AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MIN_CLASSES=0

# ── Project vault (AES-256-GCM envelopes for project secrets) ──
# Required (32+ chars) whenever the vault API is used in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEY=

# -- AI Backend Builder (Phase 9: local planner default, no keys needed) --
AI_PROVIDER=local
AI_MODEL=local-planner-v1
# Frontier models: AI_PROVIDER=openai-compatible + AI_MODEL + AI_API_KEY (never commit)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_MS=60000
AI_RATE_MAX=20
AI_MAX_PROMPT_CHARS=8000

# -- Billing + usage metering (Phase 12: manual provider default, no charges) --
# manual = plan administration without a payment rail; named providers resolve
# when their credentials + SDK wiring land. Webhook secrets live in env only.
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=
BILLING_DEFAULT_PLAN=free
BILLING_RATE_MAX=60
BILLING_RAW_RETENTION_DAYS=90

# -- Agent access tokens (Phase 13: dedicated cn_agent_* credentials) --
# Per-token request budget per rate-limit window (abuse protection).
AGENT_RATE_MAX=300
AGENT_ACTIVITY_RETENTION_DAYS=180

# -- Automated control-plane backups (worker service) --
# The worker runs pg_dump on BACKUP_INTERVAL_MS when true. BACKUP_DIR must be
# a persistent volume in production (Railway volume mount). Dumps are
# AES-256-GCM encrypted with BACKUP_ENCRYPTION_KEY (required in production).
BACKUP_ENABLED=false
BACKUP_DIR=./.data/backups
BACKUP_INTERVAL_MS=3600000
BACKUP_RETENTION_COUNT=7
BACKUP_ENCRYPTION_KEY=
# Optional empty scratch DB URL for restore-verification each cycle.
# BACKUP_VERIFY_URL=postgres://cloudnivo:<password>@localhost:5432/cn_verify

