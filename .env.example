# ── CloudNivo local/dev example. Copy to `.env` and fill in real values. ──
# NEVER commit `.env` with real secrets.

# ── Runtime ──
NODE_ENV=development
LOG_LEVEL=info
# Public base URL of the dashboard (used for CORS + links)
APP_URL=http://localhost:3000
# Base URL of the standalone API (apps/api). Dashboard API routes use APP_URL.
API_URL=http://localhost:3001
API_PORT=3001

# ── Database (Docker compose defaults) ──
POSTGRES_USER=cloudnivo
POSTGRES_PASSWORD=cloudnivo_dev_password_change_me
POSTGRES_DB=cloudnivo
POSTGRES_PORT=5432
# Control-plane connection string. The app reads DATABASE_URL first.
DATABASE_URL=postgres://cloudnivo:cloudnivo_dev_password_change_me@localhost:5432/cloudnivo

# ── Redis (Docker compose defaults) ──
REDIS_PORT=6379
REDIS_PASSWORD=
# ioredis URL. Empty password in local dev is OK; production MUST set one.
REDIS_URL=redis://localhost:6379

# ── Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ISSUER=cloudnivo
JWT_EXPIRES_IN=3600

# ── CORS ──
# Comma-separated allowlist for browser clients. Keep tight in production.
CORS_ORIGINS=http://localhost:3000

# ── Rate limiting (in-memory default; Redis-backed in production) ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ── Storage (local filesystem default; S3-compatible later) ──
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
# For future S3-compatible driver:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Realtime (in-memory default; Redis pub/sub later) ──
REALTIME_DRIVER=memory

# ── Provisioning (Phase 2: local Docker database engine) ──
# docker = real containers; fake = test-only in-memory provider (never in prod).
PROVISION_DRIVER=docker
POSTGRES_IMAGE=postgres:16-alpine
PROVISION_NETWORK=cloudnivo
PROVISION_BASE_PORT=15432
# Resource limits (enforced server-side, never hard-coded in routes):
PROVISION_MAX_DATABASES=20
PROVISION_MAX_DB_SIZE_MB=1024
PROVISION_MAX_CONNECTIONS=50
PROVISION_MAX_SQL_MS=15000
PROVISION_MAX_SQL_ROWS=500
PROVISION_MAX_ATTEMPTS=3
PROVISION_HEALTH_TIMEOUT_MS=60000
# Dashboard → standalone API base URL (used by client components):
# NEXT_PUBLIC_API_URL=http://localhost:3001
